<?xml version="1.0" encoding="utf-8" ?>
<!-- הגדרות NLog. הקוד כותב דרך ILogger הרגיל של .NET, ו-NLog מנתב את ההודעות ליעדים שלהלן -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- רמת המינימום נקבעת ב-Program.cs לפי appsettings (Debug בפיתוח, Info בייצור) -->
  <variable name="minLevel" value="Info" />
  <variable name="lineLayout"
            value="${longdate}|${level:uppercase=true}|${scopeproperty:item=CorrelationId:whenEmpty=-}|${logger}|${message}${onexception:inner=|${exception:format=tostring}}" />

  <targets async="true">
    <!-- כל הלוגים, קובץ לכל יום -->
    <target xsi:type="File" name="allFile" encoding="utf-8"
            fileName="${basedir}/logs/clinic-${shortdate}.log"
            layout="${lineLayout}"
            archiveAboveSize="10485760" maxArchiveFiles="14" />

    <!-- Warning ומעלה בקובץ נפרד: התנגשויות על תורים ושגיאות - קל למצוא אותן -->
    <target xsi:type="File" name="warningsFile" encoding="utf-8"
            fileName="${basedir}/logs/clinic-warnings-${shortdate}.log"
            layout="${lineLayout}" />

    <!-- קונסול: בענן זה היעד שמערכת איסוף הלוגים קוראת ממנו -->
    <target xsi:type="Console" name="console" layout="${lineLayout}" />
  </targets>

  <rules>
    <!-- הודעות Info הרבות של Microsoft לא נכתבות; Warning ומעלה שלהן כן -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <logger name="*" minlevel="${var:minLevel}" writeTo="allFile,console" />
    <logger name="*" minlevel="Warn" writeTo="warningsFile" />
  </rules>
</nlog>
